# Suki Ethnic - backend environment variables
# Copy to .env and adjust for your environment.

PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/suki

# JWT signing secret - use a long random string in production
JWT_SECRET=change_me_in_production

# PayU payment gateway credentials (documents only - ask the merchant for real keys)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# 'test' (sandbox) or 'production'
PAYU_ENV=test

# Public frontend origin, redirect target of the PayU webhooks
FRONTEND_URL=http://localhost:3000