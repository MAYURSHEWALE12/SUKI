# Suki Ethnic - backend environment variables
# Copy to .env and adjust for your environment.

PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/suki

# JWT signing secret - REQUIRED. The server refuses to start with a missing,
# known-default, or (in production) <32-char secret.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# PayU payment gateway credentials (documents only - ask the merchant for real keys)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# 'test' (sandbox) or 'production'
PAYU_ENV=test

# Public frontend origin, redirect target of the PayU webhooks
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed browser origins (defaults to localhost:3000 + FRONTEND_URL)
CORS_ORIGIN=http://localhost:3000

# Set to 'false' if the server is directly exposed (no reverse proxy).
# Behind nginx/cloudflare etc. leave unset so rate limits see real client IPs.
TRUST_PROXY=

# Set to 'true' to write PayU callback debug dumps (payu-debug.json / payu-error.json).
# Dumps are sanitized (no raw email/name/address) but should stay off in production.
PAYU_DEBUG=

# SMTP settings for transactional email (password reset, order notifications).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, app password in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_NAME=Suki Ethnic
FROM_EMAIL=

# Abandoned-cart reminder sweep (set ABANDONED_CART_ENABLED=false to disable).
# Emails customers whose orders are unpaid for more than ABANDONED_CART_HOURS,
# scanned every ABANDONED_CART_INTERVAL_MIN minutes. One reminder per order.
ABANDONED_CART_ENABLED=true
ABANDONED_CART_HOURS=24
ABANDONED_CART_INTERVAL_MIN=60